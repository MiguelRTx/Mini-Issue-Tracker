<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
    <div class="page-header">
        <div>
            <a href="/projects" class="back-link">Proyectos</a>
            <h1 class="page-title"><%= project.nombre %></h1>
            <p class="page-subtitle"><%= project.descripcion %></p>
        </div>
        <div class="header-actions">
            <a href="/projects/<%= project.id %>/tickets" class="btn btn-primary">Ver Tablero</a>
            <% if (isOwner) { %>
                <a href="/projects/<%= project.id %>/edit" class="btn btn-outline">Editar</a>
                <form action="/projects/<%= project.id %>/delete" method="POST" onsubmit="return confirm('Eliminar este proyecto y todos sus tickets?')">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            <% } %>
        </div>
    </div>

    <div class="detail-grid">
        <div class="detail-section">
            <h2 class="section-title">Informacion del Proyecto</h2>
            <div class="info-list">
                <div class="info-item">
                    <span class="info-label">Dueno</span>
                    <span class="info-value"><%= project.owner.nombre %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Fecha de creacion</span>
                    <span class="info-value"><%= new Date(project.createdAt).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">Miembros</span>
                    <span class="info-value"><%= project.members.length %> persona(s)</span>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <h2 class="section-title">Equipo</h2>

            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>
            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>

            <div class="members-list">
                <% project.members.forEach(member => { %>
                    <div class="member-item">
                        <div class="member-info">
                            <span class="member-avatar"><%= member.nombre.charAt(0).toUpperCase() %></span>
                            <div>
                                <span class="member-name"><%= member.nombre %></span>
                                <span class="member-email"><%= member.email %></span>
                            </div>
                        </div>
                        <div class="member-actions">
                            <% if (member.id === project.owner_id) { %>
                                <span class="badge badge-owner">Dueno</span>
                            <% } else if (isOwner) { %>
                                <form action="/projects/<%= project.id %>/members/<%= member.id %>/remove" method="POST" onsubmit="return confirm('Quitar a <%= member.nombre %> del proyecto?')">
                                    <button type="submit" class="btn-icon btn-danger-icon" title="Quitar miembro">X</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if (isOwner) { %>
                <div class="add-member-form">
                    <h3 class="subsection-title">Agregar miembro</h3>
                    <form action="/projects/<%= project.id %>/members" method="POST" class="inline-form">
                        <input type="email" name="email" class="form-input" placeholder="correo@usuario.com" required>
                        <button type="submit" class="btn btn-secondary">Agregar</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
</div>

</body>
</html>
