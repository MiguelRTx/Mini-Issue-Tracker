<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
    <div class="page-header">
        <div>
            <a href="/projects/<%= project.id %>/tickets" class="back-link">Tablero</a>
            <h1 class="page-title"><%= ticket ? 'Editar Ticket' : 'Nuevo Ticket' %></h1>
        </div>
    </div>

    <div class="form-card">
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="<%= ticket ? '/projects/' + project.id + '/tickets/' + ticket.id + '/edit' : '/projects/' + project.id + '/tickets' %>" method="POST">

            <div class="form-group">
                <label for="titulo" class="form-label">Titulo <span class="required">*</span></label>
                <input
                    type="text"
                    id="titulo"
                    name="titulo"
                    class="form-input"
                    placeholder="Ej: Error en el modulo de pagos"
                    value="<%= ticket ? ticket.titulo : '' %>"
                    required
                >
            </div>

            <div class="form-group">
                <label for="descripcion" class="form-label">Descripcion <span class="required">*</span></label>
                <textarea
                    id="descripcion"
                    name="descripcion"
                    class="form-input form-textarea"
                    placeholder="Describe el problema o tarea en detalle..."
                    required
                ><%= ticket ? ticket.descripcion : '' %></textarea>
            </div>

            <div class="form-group">
                <label for="assigned_to" class="form-label">Asignar a</label>
                <select id="assigned_to" name="assigned_to" class="form-input form-select">
                    <option value="">-- Sin asignar --</option>
                    <% members.forEach(member => { %>
                        <option value="<%= member.id %>"
                            <%= ticket && ticket.assigned_to == member.id ? 'selected' : '' %>>
                            <%= member.nombre %> (<%= member.email %>)
                        </option>
                    <% }) %>
                </select>
                <small class="form-hint">Se requiere responsable para iniciar el ticket</small>
            </div>

            <div class="form-actions">
                <a href="/projects/<%= project.id %>/tickets" class="btn btn-ghost light">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <%= ticket ? 'Guardar cambios' : 'Crear ticket' %>
                </button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
