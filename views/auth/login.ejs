<%- include('../partials/header') %>

<div class="auth-wrapper">
    <div class="auth-left">
        <div class="auth-brand">
            <div class="auth-brand-logo">IT</div>
            <span class="auth-brand-name">Issue Tracker</span>
        </div>
        <div class="auth-left-text">
            <h2 class="auth-left-title">Gestiona proyectos<br>con precision</h2>
            <p class="auth-left-sub">Organiza tu equipo, asigna tareas y controla el progreso de cada proyecto en un solo lugar.</p>
        </div>
    </div>
    <div class="auth-right">
        <div class="auth-card">
            <h1 class="auth-title">Iniciar sesion</h1>
            <p class="auth-subtitle">Ingresa tus credenciales para continuar</p>

            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>

            <form action="/auth/login" method="POST" class="auth-form">
                <div class="form-group">
                    <label for="email" class="form-label">Correo electronico</label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="correo@empresa.com" required autocomplete="email">
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">Contrasena</label>
                    <input type="password" id="password" name="password" class="form-input" placeholder="Ingresa tu contrasena" required autocomplete="current-password">
                </div>
                <button type="submit" class="btn btn-primary btn-full" style="margin-top:8px;">Iniciar sesion</button>
            </form>

            <p class="auth-footer">No tienes cuenta? <a href="/auth/register" class="auth-link">Registrarse</a></p>
        </div>
    </div>
</div>

</body>
</html>
