<nav class="navbar">
    <div class="navbar-brand">
        <a href="/projects" class="brand-link">
            <span class="brand-logo">IT</span>
            <span class="brand-name">Issue Tracker</span>
        </a>
    </div>
    <div class="navbar-actions">
        <% if (typeof user !== 'undefined' && user) { %>
            <span class="user-badge">
                <span class="user-avatar"><%= user.nombre.charAt(0).toUpperCase() %></span>
                <span class="user-name"><%= user.nombre %></span>
            </span>
            <form action="/auth/logout" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm">Cerrar sesion</button>
            </form>
        <% } %>
    </div>
</nav>
