<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Proyectos</h1>
            <p class="page-subtitle">Proyectos a los que perteneces</p>
        </div>
        <a href="/projects/new" class="btn btn-primary">+ Nuevo Proyecto</a>
    </div>

    <% if (projects.length === 0) { %>
        <div class="empty-state">
            <div class="empty-icon">P</div>
            <h2>Sin proyectos</h2>
            <p>Crea tu primer proyecto para comenzar a gestionar tickets</p>
            <a href="/projects/new" class="btn btn-primary">Crear Proyecto</a>
        </div>
    <% } else { %>
        <div class="projects-grid">
            <% projects.forEach(project => { %>
                <div class="project-card">
                    <div class="project-card-header">
                        <span class="project-key"><%= project.nombre.substring(0, 4).toUpperCase() %></span>
                        <span>
                            <% if (project.owner_id === user.id) { %>
                                <span class="badge badge-owner">Dueno</span>
                            <% } else { %>
                                <span class="badge badge-member">Miembro</span>
                            <% } %>
                        </span>
                    </div>
                    <h2 class="project-name"><%= project.nombre %></h2>
                    <p class="project-desc"><%= project.descripcion %></p>
                    <div class="project-meta">
                        <span class="meta-item">Dueno: <%= project.owner.nombre %></span>
                        <span class="meta-item"><%= new Date(project.createdAt).toLocaleDateString('es-ES') %></span>
                    </div>
                    <div class="project-card-actions">
                        <a href="/projects/<%= project.id %>/tickets" class="btn btn-primary btn-sm">Ver Tablero</a>
                        <a href="/projects/<%= project.id %>" class="btn btn-ghost light btn-sm">Detalles</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

</body>
</html>
