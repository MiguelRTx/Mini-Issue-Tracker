<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="page-container">
    <div class="page-header">
        <div>
            <a href="/projects" class="back-link">Proyectos</a>
            <h1 class="page-title"><%= project ? 'Editar Proyecto' : 'Nuevo Proyecto' %></h1>
        </div>
    </div>

    <div class="form-card">
        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <form action="<%= project ? '/projects/' + project.id + '/edit' : '/projects' %>" method="POST">
            <div class="form-group">
                <label for="nombre" class="form-label">Nombre del proyecto <span class="required">*</span></label>
                <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="form-input"
                    placeholder="Ej: Sistema de Inventario"
                    value="<%= project ? project.nombre : '' %>"
                    required
                >
            </div>
            <div class="form-group">
                <label for="descripcion" class="form-label">Descripcion <span class="required">*</span></label>
                <textarea
                    id="descripcion"
                    name="descripcion"
                    class="form-input form-textarea"
                    placeholder="Describe el objetivo y alcance del proyecto..."
                    required
                ><%= project ? project.descripcion : '' %></textarea>
            </div>
            <div class="form-actions">
                <a href="/projects" class="btn btn-ghost light">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <%= project ? 'Guardar cambios' : 'Crear proyecto' %>
                </button>
            </div>
        </form>
    </div>
</div>

</body>
</html>
